# Public address people type into the browser.
BASE_URL=http://localhost
# Host name for automatic HTTPS (work.example.org), or :80 for plain HTTP.
SITE_ADDRESS=:80
HTTP_PORT=80
HTTPS_PORT=443

# At least 32 characters. Signs reset links and encrypts stored credentials.
# Generate: openssl rand -base64 48
SECRET_KEY=

# --- Database -------------------------------------------------------------
# Bundled PostgreSQL (docker compose --profile with-db): set the two passwords
# and keep the URLs in step. Own database: point the URLs at it, postgres://
# or mysql://, and ignore the passwords.
DB_PASSWORD=
QUERY_DB_PASSWORD=
DB_URL=postgres://tvn:DB_PASSWORD@db:5432/tvn
# Read-only role for the SQL query engine.
DB_QUERY_URL=postgres://tvn_query:QUERY_DB_PASSWORD@db:5432/tvn

# --- Optional ---------------------------------------------------------------
# MAX_UPLOAD_MB=50
# ROLE=all            # all | web | worker
# TVN_VERSION=latest   # or a release, e.g. 0.1.0
